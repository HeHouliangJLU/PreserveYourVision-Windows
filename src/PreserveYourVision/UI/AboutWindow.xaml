<Window x:Class="PreserveYourVision.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 Preserve Your Vision"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF3F5F7"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">
    <Border Margin="20"
            Background="White"
            BorderBrush="#FFE1E6EB"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24">
        <StackPanel>
            <TextBlock Text="Preserve Your Vision"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#FF17212B" />
            <TextBlock x:Name="VersionText"
                       Margin="0,4,0,0"
                       FontSize="13"
                       Foreground="#FF7A8691"
                       Text="Windows 版" />
            <TextBlock Margin="0,18,0,0"
                       FontSize="14"
                       LineHeight="24"
                       Foreground="#FF33404C"
                       TextWrapping="Wrap"
                       Text="常驻托盘的护眼休息提醒工具，自动执行 20-20-20 法则：每工作 20 分钟，看向 20 英尺（约 6 米）外的物体 20 秒。" />
            <TextBlock Margin="0,14,0,0"
                       FontSize="13"
                       LineHeight="22"
                       Foreground="#FF47525E"
                       TextWrapping="Wrap"
                       Text="所有配置与统计仅保存在本机 %APPDATA%\PreserveYourVision 目录，不进行任何网络请求。" />
            <TextBlock Margin="0,14,0,0"
                       FontSize="12"
                       LineHeight="20"
                       Foreground="#FF7A8691"
                       TextWrapping="Wrap"
                       Text="快捷键：休息遮罩中 Esc 跳过（受跳过策略约束），Tab 切换按钮，Enter/空格 确认。" />
            <Button Content="关闭"
                    Width="96"
                    Margin="0,22,0,0"
                    HorizontalAlignment="Right"
                    Padding="16,7"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Border>
</Window>
