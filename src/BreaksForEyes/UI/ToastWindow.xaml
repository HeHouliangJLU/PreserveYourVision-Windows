<Window x:Class="BreaksForEyes.UI.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Breaks for Eyes"
        Width="390"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Opacity="0">
    <Window.Resources>
        <Style x:Key="ToastButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF0E7C6B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF129A84" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF0A5F53" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToastSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToastButtonStyle}">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Foreground" Value="#FFE8F4F2" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="#F51C2834"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Width="26"
                        Height="26"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#99FFFFFF"
                        Cursor="Hand"
                        FontSize="13"
                        Click="CloseButton_Click" />
                <TextBlock x:Name="TitleText"
                           DockPanel.Dock="Left"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Text="Breaks for Eyes" />
            </DockPanel>
            <TextBlock x:Name="MessageText"
                       Margin="0,8,0,0"
                       Foreground="#D9FFFFFF"
                       FontSize="13"
                       LineHeight="21"
                       TextWrapping="Wrap" />
            <StackPanel x:Name="ButtonPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0" />
        </StackPanel>
    </Border>
</Window>
