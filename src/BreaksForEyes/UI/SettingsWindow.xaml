<Window x:Class="BreaksForEyes.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Breaks for Eyes 设置"
        Width="780"
        Height="840"
        MinWidth="680"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FFF3F5F7"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE1E6EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF17212B" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF47525E" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF7A8691" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF0E7C6B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF129A84" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF0A5F53" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF33404C" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFCED6DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF0F4F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24">
            <StackPanel MaxWidth="720">
                <!-- 休息节奏 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="休息节奏" Style="{StaticResource SectionTitle}" />

                        <CheckBox x:Name="ShortBreakEnabledCheck"
                                  Content="启用短休息（20-20-20 护眼）"
                                  FontSize="14"
                                  Foreground="#FF24313D" />
                        <Grid Margin="0,2,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="工作间隔（分钟）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ShortIntervalBox" Style="{StaticResource TextInputStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="休息时长（秒）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ShortDurationBox" Style="{StaticResource TextInputStyle}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="LongBreakEnabledCheck"
                                  Content="启用长休息（起身活动）"
                                  FontSize="14"
                                  Foreground="#FF24313D" />
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="工作间隔（分钟）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="LongIntervalBox" Style="{StaticResource TextInputStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="休息时长（秒）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="LongDurationBox" Style="{StaticResource TextInputStyle}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="间隔以分钟填写（支持小数，最小 5 秒），时长以秒填写。短休息与长休息各自拥有独立的总开关与计时器；两者几乎同时到期时优先显示长休息。"
                                   Style="{StaticResource HintText}" />
                    </StackPanel>
                </Border>

                <!-- 提醒方式 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="提醒方式" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="休息提醒方式" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ReminderModeCombo" Style="{StaticResource ChoiceInputStyle}">
                                    <ComboBoxItem Content="全屏遮罩（阻断）" Tag="overlay" />
                                    <ComboBoxItem Content="系统通知（不阻断）" Tag="toast" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="提前预警" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="PreBreakCombo" Style="{StaticResource ChoiceInputStyle}">
                                    <ComboBoxItem Content="关闭" Tag="0" />
                                    <ComboBoxItem Content="提前 5 秒" Tag="5" />
                                    <ComboBoxItem Content="提前 20 秒" Tag="20" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="全屏遮罩会阻断操作直到休息结束；系统通知模式仅弹出不阻断的轻量通知。"
                                   Style="{StaticResource HintText}" />
                    </StackPanel>
                </Border>

                <!-- 遮罩外观 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="遮罩外观" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="自定义图片（留空使用默认背景）" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ImagePathBox" Grid.Column="0" Style="{StaticResource TextInputStyle}" />
                            <Button x:Name="BrowseImageButton"
                                    Grid.Column="1"
                                    Content="浏览…"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BrowseImageButton_Click" />
                            <Button x:Name="ClearImageButton"
                                    Grid.Column="2"
                                    Content="清除"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ClearImageButton_Click" />
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="填充模式" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="FillModeCombo" Style="{StaticResource ChoiceInputStyle}">
                                    <ComboBoxItem Content="每屏同图（perScreen）" Tag="perScreen" />
                                    <ComboBoxItem Content="跨屏长条（spanStrip）" Tag="spanStrip" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="图片透明度" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="OpacitySlider"
                                            Grid.Column="0"
                                            Minimum="0"
                                            Maximum="1"
                                            SmallChange="0.05"
                                            LargeChange="0.1"
                                            TickFrequency="0.1"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="OpacityValueText"
                                               Grid.Column="1"
                                               Width="44"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               Foreground="#FF47525E"
                                               Text="90%" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="跨屏长条：按虚拟桌面宽度横向缩放图片，并按每块屏幕的位置裁剪，形成一条横跨所有显示器的横幅。透明度仅作用于图片层，文字与按钮保持不透明。"
                                   Style="{StaticResource HintText}" />
                    </StackPanel>
                </Border>

                <!-- 跳过策略 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="跳过策略" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="允许的跳过方式" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="SkipPolicyCombo" Style="{StaticResource ChoiceInputStyle}">
                                    <ComboBoxItem Content="立即跳过" Tag="immediate" />
                                    <ComboBoxItem Content="延迟后可跳过" Tag="delay" />
                                    <ComboBoxItem Content="禁止跳过" Tag="none" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="延迟秒数（仅“延迟后可跳过”生效）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SkipDelayBox" Style="{StaticResource TextInputStyle}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="禁止跳过时，遮罩按钮与托盘贪睡在休息中都会停用；提前预警阶段同样不允许跳过或推迟。"
                                   Style="{StaticResource HintText}" />
                    </StackPanel>
                </Border>

                <!-- 自动暂停 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="自动暂停" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="AutoFullscreenCheck"
                                      Content="全屏应用"
                                      Margin="0,0,28,0"
                                      FontSize="14"
                                      Foreground="#FF24313D" />
                            <CheckBox x:Name="AutoMeetingCheck"
                                      Content="会议 / 通话"
                                      Margin="0,0,28,0"
                                      FontSize="14"
                                      Foreground="#FF24313D" />
                            <CheckBox x:Name="AutoVideoCheck"
                                      Content="视频播放"
                                      FontSize="14"
                                      Foreground="#FF24313D" />
                        </StackPanel>
                        <TextBlock Text="启发式检测：全屏窗口、会议应用标题/进程、全屏 + 音频回放。误判时可从托盘“恢复计时”手动覆盖。"
                                   Style="{StaticResource HintText}" />
                    </StackPanel>
                </Border>

                <!-- 通用 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="通用" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="LaunchAtLoginCheck"
                                  Content="登录 Windows 时自动启动"
                                  FontSize="14"
                                  Foreground="#FF24313D" />
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="空闲检测阈值（秒）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="IdleThresholdBox" Style="{StaticResource TextInputStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="语言" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="LanguageCombo" Style="{StaticResource ChoiceInputStyle}">
                                    <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                                    <ComboBoxItem Content="English（预留）" Tag="en-US" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="语言选项会保存到配置；English 为预留项。界面本地化（FR-14）属于 P2，当前版本界面固定为简体中文。"
                                   Style="{StaticResource HintText}" />

                        <TextBlock Text="休息文案" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CustomMessageBox"
                                 Style="{StaticResource TextInputStyle}"
                                 Height="70"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="留空时使用默认文案（短休息：看向远处；长休息：起身活动）。"
                                   Style="{StaticResource HintText}" />

                        <CheckBox x:Name="SoundEnabledCheck"
                                  Content="休息开始时播放提示音"
                                  Margin="0,16,0,0"
                                  FontSize="14"
                                  Foreground="#FF24313D" />
                        <TextBlock Text="提示音文件（留空使用系统提示音）" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SoundPathBox" Grid.Column="0" Style="{StaticResource TextInputStyle}" />
                            <Button Grid.Column="1"
                                    Content="浏览…"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BrowseSoundButton_Click" />
                            <Button Grid.Column="2"
                                    Content="清除"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ClearSoundButton_Click" />
                            <Button Grid.Column="3"
                                    Content="试听"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="TestSoundButton_Click" />
                        </Grid>

                        <TextBlock Text="统计（仅保存在本地）" Style="{StaticResource FieldLabel}" />
                        <Border Background="#FFF7F9FA"
                                BorderBrush="#FFE5EAEE"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <TextBlock x:Name="StatsTextBlock"
                                       FontSize="13"
                                       LineHeight="21"
                                       Foreground="#FF33404C"
                                       TextWrapping="Wrap"
                                       Text="正在读取统计…" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="刷新统计"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="RefreshStatsButton_Click" />
                            <Button Content="清空统计"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ClearStatsButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#FFE1E6EB"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        MinWidth="88"
                        Style="{StaticResource SecondaryButton}"
                        Click="CancelButton_Click" />
                <Button Content="保存设置"
                        MinWidth="110"
                        Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
